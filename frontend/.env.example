# Phải giống hệt JWT_SECRET ở backend/.env (chỉ dùng trong proxy.ts, không lộ ra client)
JWT_SECRET=

# Địa chỉ backend API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Host/URL dùng cho proxy phân luồng admin/user
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_HOST=admin.localhost

# Supabase anon key - chỉ dùng cho Realtime (postgres_changes) ở trang admin
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cypress (tùy chọn)
# CYPRESS_TEST_USER_EMAIL=
# CYPRESS_TEST_USER_PASSWORD=

# Tile bản đồ (mặc định mirror openstreetmap.de; tile.openstreetmap.org bị chặn DNS ở một số ISP)
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.de/{z}/{x}/{y}.png
