# Supabase (dùng SERVICE ROLE key - chỉ chạy ở server, KHÔNG đưa lên client)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=

# Server
PORT=8000
NODE_ENV=development
# Danh sách origin được phép gọi API, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000,http://admin.localhost:3000

# JWT - phải giống hệt JWT_SECRET ở frontend/.env (proxy.ts dùng để xác thực cookie)
JWT_SECRET=
JWT_EXPIRES_IN=1d

# AI planner: nhà cung cấp bất kỳ có API tương thích OpenAI (mặc định Groq)
#   Groq:   AI_BASE_URL=https://api.groq.com/openai/v1                        AI_MODEL=openai/gpt-oss-120b
#   Gemini: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  AI_MODEL=gemini-3.8-flash
#   Ollama: AI_BASE_URL=http://localhost:11434/v1                              AI_MODEL=gpt-oss:20b
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
# Mức suy luận của model (low/medium/high); để trống nếu model không hỗ trợ
AI_REASONING_EFFORT=low

# PayOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Nominatim yêu cầu User-Agent định danh ứng dụng
NOMINATIM_USER_AGENT=TravelPlanner/1.0 (contact@example.com)
