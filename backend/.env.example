# Supabase (dùng SERVICE ROLE key - chỉ chạy ở server, KHÔNG đưa lên client)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=

# Server
PORT=8000
NODE_ENV=development
# Danh sách origin được phép gọi API, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000,http://admin.localhost:3000

# JWT - phải giống hệt JWT_SECRET ở frontend/.env (proxy.ts dùng để xác thực cookie)
JWT_SECRET=
JWT_EXPIRES_IN=1d

# AI planner (Groq, OpenAI-compatible API)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# PayOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Nominatim yêu cầu User-Agent định danh ứng dụng
NOMINATIM_USER_AGENT=TravelPlanner/1.0 (contact@example.com)
